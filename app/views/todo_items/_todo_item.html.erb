<%= turbo_frame_tag dom_id(todo_item) do %>
  <div class="todo-item <%= 'todo-item--completed' if todo_item.completed %>">
    <%= button_to todo_list_todo_item_path(todo_item.todo_list_id, todo_item),
          method: :patch,
          params: { todo_item: { name: todo_item.name, completed: !todo_item.completed } },
          class: "todo-item__check #{'todo-item__check--done' if todo_item.completed}",
          aria: { label: todo_item.completed ? t("todo_items.mark_pending") : t("todo_items.mark_done") } do %>
      <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/>
        <% if todo_item.completed %>
          <path d="M4.5 8l2.5 2.5 4.5-4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <% end %>
      </svg>
    <% end %>
    <span class="todo-item__name"><%= todo_item.name %></span>
    <div class="todo-item__actions">
      <%= link_to t("ui.edit"),
            edit_todo_list_todo_item_path(todo_item.todo_list_id, todo_item),
            class: "btn btn--ghost btn--icon" %>
      <%= button_to t("ui.delete"),
            todo_list_todo_item_path(todo_item.todo_list_id, todo_item),
            method: :delete,
            class: "btn btn--danger btn--icon",
            data: { turbo_confirm: t("todo_items.confirm_delete") } %>
    </div>
  </div>
<% end %>
