<div class="items-list" id="todo_items_<%= todo_list.id %>">
  <% todo_items.each do |todo_item| %>
    <%= render todo_item %>
  <% end %>
</div>

<%= turbo_frame_tag "new_todo_item_#{todo_list.id}" do %>
  <%= link_to "+ Add Item", new_todo_list_todo_item_path(todo_list), class: "add-item-trigger" %>
<% end %>
