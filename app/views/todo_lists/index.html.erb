<header class="page-header">
  <h1 class="page-header__title">Todo<span>Flow</span></h1>
</header>

<div class="new-list-area">
  <%= turbo_frame_tag "new_todo_list" do %>
    <%= render "new_list_trigger" %>
  <% end %>
</div>

<div id="todo_lists" class="card-list">
  <% @todo_lists.each do |todo_list| %>
    <%= render todo_list %>
  <% end %>
</div>
