<header class="page-header">
  <h1 class="page-header__title">Todo<span>Flow</span></h1>
  <%= turbo_frame_tag "new_todo_list" do %>
    <%= render "new_list_trigger" %>
  <% end %>
</header>

<div id="todo_lists" class="card-list">
  <%= render "todo_list_collection", todo_lists: @todo_lists %>
</div>

<div id="load_more_lists">
  <%= render "load_more_lists", pagy: @pagy %>
</div>
