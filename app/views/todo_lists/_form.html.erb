<% cancel_path ||= nil %>
<% modal_cancel ||= false %>
<%= form_with model: todo_list do |form| %>
  <% if todo_list.errors.any? %>
    <div class="field-errors">
      <% todo_list.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="list-form">
    <div class="list-form__field">
      <%= form.text_field :name, placeholder: t("todo_lists.name_placeholder") %>
    </div>
    <div class="list-form__actions">
      <%= form.submit t("ui.save"), class: "btn btn--primary btn--icon" %>
      <% if cancel_path %>
        <%= link_to t("ui.cancel"), cancel_path, class: "btn btn--ghost btn--icon" %>
      <% elsif modal_cancel %>
        <button type="button" class="btn btn--ghost btn--icon" data-action="modal#close">
          <%= t("ui.cancel") %>
        </button>
      <% end %>
    </div>
  </div>
<% end %>
