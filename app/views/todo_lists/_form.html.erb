<% cancel_path ||= nil %>
<%= form_with model: todo_list do |form| %>
  <% if todo_list.errors.any? %>
    <div class="field-errors">
      <% todo_list.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="list-form">
    <div class="list-form__field">
      <%= form.text_field :name, placeholder: "List name…" %>
    </div>
    <div class="list-form__actions">
      <%= form.submit "Save", class: "btn btn--primary btn--icon" %>
      <% if cancel_path %>
        <%= link_to "Cancel", cancel_path, class: "btn btn--ghost btn--icon" %>
      <% end %>
    </div>
  </div>
<% end %>
